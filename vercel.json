{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/admin", "destination": "https://qivalabs-admin.vercel.app/admin" },
    { "source": "/admin/:path*", "destination": "https://qivalabs-admin.vercel.app/admin/:path*" }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
